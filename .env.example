#Esto es un archivo de ejemplo, el usuario, al probar la aplicación, 
#deberá crearse un .env en su directorioy rellenar con su api key, 
#en caso de querer utilizar el modo ia, sino, se utiliza el modo numérico
 

# Proveedor del modelo de lenguaje:
#   gemini    = Gemini de Google 
#   anthropic = Claude 
#   ninguno   = solo modo numérico
LLM_PROVEEDOR=gemini

# Clave de Gemini: gratis en https://aistudio.google.com/apikey 
GEMINI_API_KEY=

# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=


# Tiempo máximo por llamada (segundos) y tope de tokens por consulta
LLM_TIMEOUT_S=60
LLM_TOPE_TOKENS_CONSULTA=80000

# Caché de respuestas validadas (0 = desactivada; útil para medir la estabilidad)
LLM_CACHE=1
